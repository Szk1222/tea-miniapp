.page { padding: 32rpx; background: #f5f7f4; min-height: 100vh; box-sizing: border-box; }
.heading { font-size: 36rpx; font-weight: 600; color: #17251d; margin-bottom: 24rpx; }
.heading-version { font-size: 24rpx; color: #688071; margin-left: 16rpx; }
.types { white-space: nowrap; margin-bottom: 24rpx; }
.types-inner { display: flex; gap: 12rpx; }
.type { flex: 0 0 auto; padding: 14rpx 26rpx; background: #fff; border-radius: 30rpx; color: #4a5a51; font-size: 25rpx; }
.type.active { background: #2e6b4f; color: #fff; }
.hint { font-size: 24rpx; color: #68786d; line-height: 1.6; margin-bottom: 16rpx; }
.editor { box-sizing: border-box; width: 100%; height: 760rpx; padding: 20rpx; background: #fff; border: 1rpx solid #dae3db; border-radius: 16rpx; font-family: monospace; font-size: 23rpx; line-height: 1.5; }
.notice { padding: 20rpx; color: #a14837; font-size: 25rpx; white-space: pre-wrap; }
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.action-button { flex: 1; font-size: 28rpx; }
.rollback { margin-top: 24rpx; color: #a14837; font-size: 27rpx; }
