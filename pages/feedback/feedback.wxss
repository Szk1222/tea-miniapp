/* 体感反馈页
   真机注意：胶囊/标签一律用 <view> 承载（固定高度 + line-height 居中），
   多列用 flex + 百分比宽度，不用 calc、不用 flex gap。 */

.fb {
  box-sizing: border-box;
  padding-bottom: 20rpx;
}

/* ---------------- 顶部 ---------------- */
.fb-hero {
  padding: 24rpx 32rpx 26rpx;
  background: linear-gradient(160deg, #EAF3EE 0%, #F5F7F4 100%);
}

.fb-hero__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.fb-hero__icon {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #2E6B4F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fb-hero__text {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.fb-hero__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #17251D;
}

.fb-hero__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5A6A61;
}

.fb-hero__privacy {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  color: #7C8A80;
}

/* 选择器一律用类名前缀，不用标签名（.fb-hero__privacy text 这种会被
   开发者工具的 wxss 编译器判为 illegal selector 并中断编译） */
.fb-hero__privacy-text {
  margin-left: 10rpx;
}

/* ---------------- 通用小标 ---------------- */
.field__sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #93A099;
}

.req {
  box-sizing: border-box;
  margin-left: 14rpx;
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #FBEDE9;
  color: #C4553F;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 34rpx;
}

/* ---------------- 选择茶方 ---------------- */
.picker {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid #E9EDE8;
  overflow: hidden;
}

.picker__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F1F3F0;
}

.picker__row:last-child {
  border-bottom: none;
}

.picker__row--hover {
  background: #FAFBF9;
}

.picker__icon {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #E8F1EC;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.picker__name {
  font-size: 29rpx;
  font-weight: 600;
  color: #17251D;
}

.picker__sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #93A099;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker__btn {
  box-sizing: border-box;
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #E8F1EC;
  color: #2E6B4F;
  font-size: 25rpx;
  line-height: 58rpx;
  text-align: center;
}

/* ---------------- 茶方摘要 ---------------- */
.tea-brief {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E9EDE8;
  box-shadow: 0 6rpx 24rpx rgba(28, 56, 41, 0.06);
}

.tea-brief__body {
  flex: 1;
  min-width: 0;
}

.tea-brief__name {
  font-size: 34rpx;
  font-weight: 600;
  color: #17251D;
}

.tea-brief__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5A6A61;
}

.tea-brief__meta {
  box-sizing: border-box;
  display: inline-block;
  margin-top: 14rpx;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}

.tea-brief__back {
  box-sizing: border-box;
  flex: 0 0 auto;
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1.5rpx solid #CFE3D7;
  color: #2E6B4F;
  font-size: 24rpx;
  line-height: 60rpx;
  text-align: center;
}

/* ---------------- 总体感受（三列） ---------------- */
.chip-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.fx-chip {
  box-sizing: border-box;
  width: 31.6%;
  flex: 0 0 auto;
  padding: 22rpx 12rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 2rpx solid #E9EDE8;
  text-align: center;
}

.fx-chip.is-on {
  border-color: #2E6B4F;
  background: #E8F1EC;
}

.fx-chip__label {
  font-size: 27rpx;
  font-weight: 600;
  color: #17251D;
}

.fx-chip.is-on .fx-chip__label {
  color: #21503A;
}

.fx-chip__hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #93A099;
}

/* ---------------- 体感 / 口味标签 ---------------- */
.feel-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.feel {
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #D9E6DE;
  color: #35473C;
  font-size: 25rpx;
  line-height: 62rpx;
}

.feel--neg {
  border-color: #F0E2C4;
  color: #8A6524;
}

.feel.is-on {
  background: #2E6B4F;
  border-color: #2E6B4F;
  color: #FFFFFF;
}

.feel--neg.is-on {
  background: #B9873A;
  border-color: #B9873A;
  color: #FFFFFF;
}

/* 口味是三选一的单选，排成与「总体感受」一致的三等分；
   不加这层的话 .feel 的自动宽度会让三颗药丸挤在左边、右侧留一大片空白 */
.taste-wrap {
  justify-content: space-between;
}

.taste {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 31.6%;
  padding: 0;
  margin: 0 0 16rpx;
  text-align: center;
}

/* ---------------- 补充描述 ---------------- */
.note-box {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E9EDE8;
  padding: 24rpx;
}

.note-box__area {
  width: 100%;
  height: 180rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #17251D;
}

.note-box__ph {
  color: #A9B4AC;
  font-size: 25rpx;
}

.note-box__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.note-box__count {
  font-size: 22rpx;
  color: #B7C1BA;
}

.note-box__clear {
  box-sizing: border-box;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #F3F5F3;
  color: #7C8A80;
  font-size: 22rpx;
  line-height: 48rpx;
}

/* ---------------- 上送开关 ---------------- */
.upload-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E9EDE8;
}

.upload-row__box {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  border-radius: 10rpx;
  border: 2rpx solid #CFE3D7;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-row__box.is-on {
  background: #2E6B4F;
  border-color: #2E6B4F;
}

.upload-row__text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5A6A61;
}

.upload-off {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #F3F5F3;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7C8A80;
}

.upload-off__text {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

/* ---------------- 提交 ---------------- */
.submit {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 34rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #E6EBE6;
  color: #A9B4AC;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.submit__text {
  margin-left: 12rpx;
}

.submit.is-on {
  background: #2E6B4F;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(46, 107, 79, 0.22);
}

.submit.is-on:active {
  background: #21503A;
}

/* ---------------- 提交结果 ---------------- */
.done {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #EAF3EE;
  border: 1rpx solid #CFE3D7;
}

.done--warn {
  background: #FBF4E6;
  border-color: #F0E2C4;
}

.done__head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.done__title {
  margin-left: 12rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: #21503A;
}

.done--warn .done__title {
  color: #8A6524;
}

.done__line {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: #4A5A50;
}

.done--warn .done__line {
  color: #7E5F22;
}

.done__actions {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 26rpx;
}

.done__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.done__btn--ghost {
  box-sizing: border-box;
  width: 34%;
  flex: 0 0 auto;
  border: 1.5rpx solid #CFE3D7;
  background: #FFFFFF;
  color: #2E6B4F;
}

.done__btn--main {
  box-sizing: border-box;
  width: 62%;
  flex: 0 0 auto;
  background: #2E6B4F;
  color: #FFFFFF;
}

/* ---------------- 记录列表 ---------------- */
.rec-list {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid #E9EDE8;
  overflow: hidden;
}

.rec {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #F1F3F0;
}

.rec:last-child {
  border-bottom: none;
}

.rec__body {
  flex: 1;
  min-width: 0;
}

.rec__top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.rec__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #17251D;
}

.rec__tag {
  box-sizing: border-box;
  height: 38rpx;
  padding: 0 16rpx;
  margin-left: 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 38rpx;
}

.rec__tag--ok {
  background: #E8F1EC;
  color: #2E6B4F;
}

.rec__tag--warn {
  background: #FBF4E6;
  color: #8A6524;
}

.rec__tag--flat {
  background: #F3F5F3;
  color: #7C8A80;
}

.rec__feel {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #5A6A61;
}

.rec__time {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #B7C1BA;
}

.rec__del {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------------- 底部说明 ---------------- */
.fb-note {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 34rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #F3F5F3;
}

.fb-note__text {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  line-height: 1.66;
  color: #7C8A80;
}
