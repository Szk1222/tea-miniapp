.tabs {
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  white-space: nowrap;
  padding: 20rpx 0 12rpx;
  background: rgba(245, 247, 244, 0.97);
  backdrop-filter: blur(16rpx);
}

.tabs__inner {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  padding: 0 32rpx;
}

.tabs__item {
  flex: 0 0 auto;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E6EBE6;
  font-size: 26rpx;
  color: #5A6A61;
  line-height: 1.3;
}

.tabs__item.is-on {
  background: #2E6B4F;
  border-color: #2E6B4F;
  color: #FFFFFF;
  font-weight: 600;
}

.lead {
  padding: 26rpx 4rpx 24rpx;
  font-size: 24rpx;
  color: #87958B;
  line-height: 1.7;
}

/* ---------------- 体质列表 ---------------- */
.c-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.c-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 26rpx;
  background: #FFFFFF;
  border: 1rpx solid #E9EDE8;
  border-radius: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(28, 56, 41, 0.04);
}

.c-item--hover {
  background: #FAFBF9;
  transform: scale(0.99);
}

.c-item__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.c-item__top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.c-item__name {
  font-size: 31rpx;
  font-weight: 600;
  color: #17251D;
}

/* 胶囊标签：同 chat 顶部标签，必须由 block 盒子承载 padding + 圆角 + 底色，
   挂在行内 <text> 上真机会被压扁、圆角与底色渲染异常 */
.c-item__mine {
  box-sizing: border-box;
  flex: 0 0 auto;
  height: 36rpx;
  padding: 0 14rpx;
  margin-left: 14rpx;
  border-radius: 999rpx;
  background: #E8F1EC;
  color: #2E6B4F;
  font-size: 19rpx;
  line-height: 36rpx;
  text-align: center;
  white-space: nowrap;
}

.c-item__short {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #93A099;
}

.c-item__brief {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6E7C73;
  line-height: 1.6;
}

/* ---------------- 食材网格 ---------------- */
/* 与首页「九种体质」同款两列自适应写法：不用 calc()、不用 flex gap，
   并显式 box-sizing，避免真机上退化成单列（详见 index.wxss 注释） */
.i-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.i-item {
  box-sizing: border-box;
  width: 48.4%;
  flex: 0 0 auto;
  margin-bottom: 18rpx;
  padding: 26rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E9EDE8;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(28, 56, 41, 0.04);
}

.i-item--hover {
  background: #FAFBF9;
  transform: scale(0.985);
}

.i-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #17251D;
}

.i-item__nature {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #4E9A72;
}

.i-item__effect {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #6E7C73;
  line-height: 1.55;
}

/* ---------------- FAQ ---------------- */
.faq {
  background: #FFFFFF;
  border: 1rpx solid #E9EDE8;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(28, 56, 41, 0.04);
}

.faq__item + .faq__item {
  border-top: 1rpx solid #F1F3F0;
}

.faq__q {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 32rpx 28rpx;
}

.faq__q:active {
  background: #FAFBF9;
}

.faq__q-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #24352C;
  line-height: 1.55;
}

.faq__arrow {
  flex: 0 0 auto;
  transition: transform 0.22s ease;
}

.faq__arrow.is-open {
  transform: rotate(180deg);
}

.faq__a {
  padding: 0 28rpx 32rpx;
  font-size: 25rpx;
  color: #5A6A61;
  line-height: 1.78;
  animation: fadeUp 0.24s ease both;
}

/* ---------------- 免责 ---------------- */
.disclaimer {
  margin-top: 36rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #F1F4F1;
}

.disclaimer__text {
  flex: 1;
  font-size: 22rpx;
  color: #8B978F;
  line-height: 1.72;
}
