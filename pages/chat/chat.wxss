.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7F4;
}

/* ---------------- 顶部状态条 ---------------- */
.chat-top {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx 16rpx;
  background: #F5F7F4;
}

.chat-top__left {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.live-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #46A16B;
  box-shadow: 0 0 0 6rpx rgba(70, 161, 107, 0.14);
}

.chat-top__title {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #35473C;
  white-space: nowrap;
}

/* 胶囊标签：必须由 block 盒子承载 padding + 圆角 + 底色。
   挂在行内 <text> 上时真机不认垂直内边距，会被压成一条细扁色块，圆角与描边也会渲染异常。
   这里用「固定高度 + line-height 垂直居中 + text-align 水平居中」，不依赖 flex 居中。 */
.chat-top__tag {
  flex: 0 0 auto;
  height: 40rpx;
  padding: 0 16rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: #E8F1EC;
  color: #2E6B4F;
  font-size: 20rpx;
  line-height: 40rpx;
  text-align: center;
  white-space: nowrap;
}

/* 推理链路标识：点一下可在「AI 增强」与「本地模式」之间切换 */
.chat-top__tag--mode {
  background: #EFEEE9;
  color: #7C8A82;
  border: 1rpx solid #E3E1DA;
}

.chat-top__tag--mode.is-ai {
  background: #FBF3E4;
  color: #B9873A;
  border-color: #F0E1C6;
}

.chat-top__reset {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  font-size: 23rpx;
  color: #93A099;
}

.chat-top__reset-label {
  margin-left: 6rpx;
}

.chat-top__reset:active {
  opacity: 0.6;
}

/* ---------------- 消息滚动区 ---------------- */
.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-list {
  padding: 8rpx 28rpx 0;
}

.chat-bottom-space {
  height: 40rpx;
}

.msg {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 28rpx;
  animation: fadeUp 0.28s ease both;
}

.msg--user {
  flex-direction: row-reverse;
}

.msg--wide {
  align-items: flex-start;
}

.msg--chips {
  padding-left: 0;
  margin-left: 0;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.avatar--bot {
  background: #E8F1EC;
}

.avatar--user {
  background: #2E6B4F;
}

/* ---------------- 气泡 ---------------- */
.bubble {
  max-width: 500rpx;
  margin: 0 18rpx;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.72;
  word-break: break-word;
}

.bubble--bot {
  background: #FFFFFF;
  color: #22322A;
  border: 1rpx solid #E9EDE8;
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(28, 56, 41, 0.04);
}

.bubble--small {
  font-size: 23rpx;
  color: #8B978F;
  background: #F3F5F3;
  border-color: #EDF0EC;
  line-height: 1.68;
}

.bubble--user {
  background: #2E6B4F;
  color: #FFFFFF;
  border-top-right-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(46, 107, 79, 0.18);
}

.bubble__text {
  white-space: pre-wrap;
}

/* 打字动画 */
.dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding-top: 6rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #9FB3A6;
  animation: blink 1.1s infinite ease-in-out;
}

.dot--2 { animation-delay: 0.18s; }
.dot--3 { animation-delay: 0.36s; }

/* ---------------- 提示条 ---------------- */
.note {
  flex: 1;
  max-width: 540rpx;
  margin-right: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
}

.note--warn {
  background: #FBF4E6;
  border: 1rpx solid #F0E2C4;
}

.note--danger {
  background: #FBEDE9;
  border: 1rpx solid #F0D6CE;
}

.note__text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7E5F22;
}

.note--danger .note__text {
  color: #A84A36;
}

/* ---------------- 茶方卡片 ---------------- */
.tea-list {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.tea-list__item {
  margin-bottom: 18rpx;
}

.tea-list__item:last-child {
  margin-bottom: 0;
}

/* ---------------- 测评引导卡 ---------------- */
.cta-card {
  flex: 1;
  max-width: 540rpx;
  margin-right: 12rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(140deg, #F2F8F4 0%, #FFFFFF 100%);
  border: 1rpx solid #D8E9DF;
}

.cta-card__top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 18rpx;
}

.cta-card__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #2E6B4F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.cta-card__title {
  font-size: 29rpx;
  font-weight: 600;
  color: #17251D;
}

.cta-card__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7C8A80;
  line-height: 1.55;
}

.cta-card__btn {
  margin-top: 24rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: #2E6B4F;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

.cta-card__btn:active {
  background: #21503A;
}

/* ---------------- 快捷选项 ---------------- */
.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-left: 82rpx;
}

.chip {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #D9E6DE;
  color: #2E6B4F;
  font-size: 25rpx;
  line-height: 1.4;
}

.chip:active {
  background: #E8F1EC;
}

/* ---------------- 输入区 ---------------- */
.composer {
  position: fixed;
  left: 0;
  right: 0;
  /* 兜底值 + calc 覆盖，理由同 app.wxss 的 .tabbar-gap */
  bottom: 108rpx;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  z-index: 950;
  background: rgba(245, 247, 244, 0.97);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid #E6EBE6;
  transition: bottom 0.2s ease;
}

.composer.is-focus {
  bottom: 0;
}

.composer__bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 28rpx;
}

.composer__input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E9E4;
  font-size: 28rpx;
  color: #17251D;
}

.composer__ph {
  color: #A9B4AC;
  font-size: 26rpx;
}

.composer__send {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E6EBE6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  transition: background 0.18s ease;
}

.composer__send.is-on {
  background: #2E6B4F;
}

.composer__tabbar-gap {
  height: 0;
}
