/* 页面高度由 page 撑满视口，根容器用普通流的 height:100% 承接。
   这里刻意不用 position:fixed 四边锚定：fixed 会让 page 元素高度归零，
   页面的触摸命中区域随之变得不可靠（表现就是「看得见、点不动」）。
   用高度而非定位，同样能做到整页不滚动、不溢出。

   注意：不写 `page { height: 100% }`。wxss 里用标签名选择器（page 也是标签名）
   会被开发者工具的 wxss 编译器判为 illegal selector 并中断编译，
   页面高度改由 chat.wxml 首个节点 <page-meta page-style="height:100%" /> 设置。 */
.chat-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: #F5F7F4;
}

/* ---------------- 顶部状态条 ---------------- */
.chat-top {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx 10rpx;
  background: #F5F7F4;
}

.chat-top__left {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.live-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #46A16B;
  box-shadow: 0 0 0 6rpx rgba(70, 161, 107, 0.14);
}

.chat-top__title {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #35473C;
  white-space: nowrap;
}

/* 胶囊标签：必须由 block 盒子承载 padding + 圆角 + 底色。
   挂在行内 <text> 上时真机不认垂直内边距，会被压成一条细扁色块，圆角与描边也会渲染异常。
   这里用「固定高度 + line-height 垂直居中 + text-align 水平居中」，不依赖 flex 居中。 */
.chat-top__tag {
  box-sizing: border-box;
  flex: 0 0 auto;
  height: 40rpx;
  padding: 0 16rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: #E8F1EC;
  color: #2E6B4F;
  font-size: 20rpx;
  line-height: 40rpx;
  text-align: center;
  white-space: nowrap;
}

/* ---------------- 模式切换：胶囊分段开关 ---------------- */
/* 顶部条与开关行都是可点区域，显式建立层叠上下文，
   避免被后面的消息滚动区在任何机型上盖住（点击丢失的常见成因）。 */
.chat-top,
.mode-row {
  position: relative;
  z-index: 2;
}

.mode-row {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 2rpx 32rpx 14rpx;
  background: #F5F7F4;
}

/* 体质标签挪到第二行行首时，不再需要为「跟在标题后」预留的左间距 */
.mode-row .chat-top__tag {
  margin-left: 0;
}

/* 胶囊轨道：整颗圆角 + 6rpx 内边距，选中段用白色「药丸」抬起来。
   只用 flex + 固定高度 + 行高居中，不含 calc / 绝对定位 —— 真机上更稳。 */
.mode-switch {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 14rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #E9EFEA;
  border: 1rpx solid #DFE7E0;
}

/* 段高 56rpx + 轨道内边距，整颗约 68rpx（≈34px），横向每段 ≈150rpx，热区充足 */
.mode-switch__seg {
  box-sizing: border-box;
  flex: 0 0 auto;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
  white-space: nowrap;
  color: #7C8A82;
  background: transparent;
  transition: background 0.2s ease, color 0.2s ease;
}

.mode-switch__seg.is-on {
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(28, 56, 41, 0.10);
}

/* 选中态用颜色区分「谁在用哪条链路」：本地=品牌绿，AI=辅助金 */
.mode-switch__seg--local.is-on {
  color: #2E6B4F;
  font-weight: 600;
}

.mode-switch__seg--ai.is-on {
  color: #8A6524;
  font-weight: 600;
}

.mode-switch__seg--press {
  opacity: 0.6;
}

/* 右侧：本轮回答的真实来源 */
.mode-row__hint {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  text-align: right;
  font-size: 21rpx;
  line-height: 1.4;
  color: #93A099;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chat-top__reset {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 16rpx;
  font-size: 23rpx;
  color: #93A099;
}

.chat-top__reset-label {
  margin-left: 6rpx;
}

.chat-top__reset:active {
  opacity: 0.6;
}

/* ---------------- 消息滚动区 ---------------- */
.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-list {
  padding: 8rpx 28rpx 0;
}

.chat-bottom-space {
  height: 40rpx;
}

/* scroll-into-view 的落点。给 1rpx 而不是 0：零高度元素在部分安卓 WebView
   里会被判定为不可见，导致 scroll-into-view 失效 */
.chat-anchor {
  height: 1rpx;
}

/* 顾问侧气泡：基础样式即「头像在左」，用户侧用 .msg--user 反向 */
.msg {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 28rpx;
  animation: fadeUp 0.28s ease both;
}

.msg--user {
  flex-direction: row-reverse;
}

.msg--wide {
  align-items: flex-start;
}

.msg--chips {
  padding-left: 0;
  margin-left: 0;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.avatar--bot {
  background: #E8F1EC;
}

.avatar--user {
  background: #2E6B4F;
}

/* ---------------- 气泡 ---------------- */
.bubble {
  box-sizing: border-box;
  max-width: 500rpx;
  margin: 0 18rpx;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.72;
  word-break: break-word;
}

.bubble--bot {
  box-sizing: border-box;
  background: #FFFFFF;
  color: #22322A;
  border: 1rpx solid #E9EDE8;
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(28, 56, 41, 0.04);
}

.bubble--small {
  font-size: 23rpx;
  color: #8B978F;
  background: #F3F5F3;
  border-color: #EDF0EC;
  line-height: 1.68;
}

.bubble--user {
  background: #2E6B4F;
  color: #FFFFFF;
  border-top-right-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(46, 107, 79, 0.18);
}

.bubble__text {
  white-space: pre-wrap;
}

/* 打字动画 */
.dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding-top: 6rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #9FB3A6;
  animation: blink 1.1s infinite ease-in-out;
}

.dot--2 { animation-delay: 0.18s; }
.dot--3 { animation-delay: 0.36s; }

/* ---------------- 提示条 ---------------- */
.note {
  box-sizing: border-box;
  flex: 1;
  max-width: 540rpx;
  margin-right: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
}

.note--warn {
  background: #FBF4E6;
  border: 1rpx solid #F0E2C4;
}

.note--danger {
  background: #FBEDE9;
  border: 1rpx solid #F0D6CE;
}

.note__text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.7;
  color: #7E5F22;
}

.note--danger .note__text {
  color: #A84A36;
}

/* ---------------- 茶方卡片 ---------------- */
.tea-list {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.tea-list__item {
  margin-bottom: 18rpx;
}

.tea-list__item:last-child {
  margin-bottom: 0;
}

/* ---------------- 测评引导卡 ---------------- */
.cta-card {
  box-sizing: border-box;
  flex: 1;
  max-width: 540rpx;
  margin-right: 12rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(140deg, #F2F8F4 0%, #FFFFFF 100%);
  border: 1rpx solid #D8E9DF;
}

.cta-card__top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 18rpx;
}

.cta-card__icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #2E6B4F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.cta-card__title {
  font-size: 29rpx;
  font-weight: 600;
  color: #17251D;
}

.cta-card__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7C8A80;
  line-height: 1.55;
}

.cta-card__btn {
  margin-top: 24rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: #2E6B4F;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

.cta-card__btn:active {
  background: #21503A;
}

/* ---------------- 快捷选项 ---------------- */
.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-left: 82rpx;
}

.chip {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #D9E6DE;
  color: #2E6B4F;
  font-size: 25rpx;
  line-height: 1.4;
}

.chip:active {
  background: #E8F1EC;
}

/* ---------------- 自定义症状入口 ---------------- */
.sym-entry {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 32rpx 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx dashed #CFE3D7;
}

.sym-entry--hover {
  background: #F4FAF6;
}

.sym-entry__text {
  flex: 1;
  min-width: 0;
  margin: 0 10rpx;
  font-size: 23rpx;
  color: #2E6B4F;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------------- 科普推送 ---------------- */
.kn-push {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  padding: 24rpx 24rpx 10rpx;
  border-radius: 24rpx;
  background: #F7FAF8;
  border: 1rpx solid #DFEAE3;
}

.kn-push__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.kn-push__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #21503A;
}

.kn-push__hide {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 44rpx;
  padding: 0 6rpx;
  font-size: 21rpx;
  color: #A9B4AC;
}

.kn-push__hide-text {
  margin-left: 4rpx;
}

.kn-push__sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #93A099;
}

.kn-push__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E9EDE8;
}

.kn-push__item--hover {
  background: #F4FAF6;
}

.kn-push__tag {
  box-sizing: border-box;
  flex: 0 0 auto;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #E8F1EC;
  color: #2E6B4F;
  font-size: 20rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.kn-push__body {
  flex: 1;
  min-width: 0;
  margin: 0 14rpx;
}

.kn-push__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #17251D;
}

.kn-push__desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #7C8A80;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ---------------- 输入区 ----------------
   输入区是正常流内的 flex 子项（不再 position:fixed）。
   固定在视口底部时必须自己算「消息区要留多少空」，一旦键盘参与就极易算错；
   交给 flex 布局后，输入区占多高，消息区就自动少多高，不会互相压盖。
   键盘让位统一由 .chat-page 的 padding-bottom 完成。 */
.composer {
  flex: 0 0 auto;
  background: #F5F7F4;
  border-top: 1rpx solid #E6EBE6;
}

.composer__bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 28rpx;
}

.composer__input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E4E9E4;
  font-size: 28rpx;
  color: #17251D;
}

.composer__ph {
  color: #A9B4AC;
  font-size: 26rpx;
}

.composer__send {
  width: 80rpx;
  height: 80rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #E6EBE6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  transition: background 0.18s ease;
}

.composer__send.is-on {
  background: #2E6B4F;
}

/* tabBar 占位：未聚焦时垫在输入区下方，避免被自定义 tabBar 盖住；
   聚焦时 tabBar 收起，两个占位一起归零 */
.composer__gap {
  height: 108rpx;
}

.composer__safe {
  height: env(safe-area-inset-bottom);
}

.composer__gap.is-off,
.composer__safe.is-off {
  height: 0;
}
