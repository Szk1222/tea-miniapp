# ============================================================
#  茶历方 Agent 服务 · 环境变量
#  复制为 .env 后填写：cp server/.env.example server/.env
#  启动：node --env-file=server/.env server/src/index.js
# ============================================================

# ---------- 服务 ----------
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=*

# ---------- 大模型：火山方舟（豆包）默认配置 ----------
# 1) 取 API Key：火山方舟控制台 → API Key 管理 → 创建
#    https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
# 2) 开通模型：方舟控制台「开通管理」里把要用的模型点开通，否则会报 ModelNotOpen
#    https://console.volcengine.com/ark/region:ark+cn-beijing/openManagement
# 3) 模型 ID 要用控制台「模型列表」里的准确 ID（形如 doubao-seed-2-1-lite-260915），
#    不是页面上显示的昵称。豆包迭代很快，1.6 系列已下线，以控制台在售列表为准。
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=在这里填你的火山方舟_API_Key
LLM_MODEL=doubao-seed-2-1-lite-260915
# 备选（同样支持 Function Calling，改这一行即可）：
#   doubao-seed-2-1-pro-260915   质量更好、更贵
#   doubao-seed-2-1-turbo-260628 更快

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=20000
LLM_MAX_TOOL_ROUNDS=4

# 深度思考开关（豆包 seed 系列私有字段）：disabled / enabled / auto
# 养生茶场景不需要长链推理，disabled 可明显降低首字延迟、减少 token 消耗。
# 换成非豆包网关时，请把它置空（LLM_THINKING=），否则多余的 thinking 字段可能被网关拒绝（400）。
LLM_THINKING=disabled

# 可选逃生舱：给请求体追加任意字段（JSON）。用来兜各家私有参数。
# LLM_EXTRA_BODY={"top_p":0.9}

# ---------- 换其他 OpenAI 兼容网关（只改上面三行 + 清空 LLM_THINKING） ----------
# DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1                        LLM_MODEL=deepseek-chat
# 阿里通义     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 智谱 GLM    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4                LLM_MODEL=glm-4-plus
# OpenAI      LLM_BASE_URL=https://api.openai.com/v1                           LLM_MODEL=gpt-4o-mini
# 本地 Ollama LLM_BASE_URL=http://127.0.0.1:11434/v1                           LLM_MODEL=qwen2.5:7b

# ---------- 检索（RAG） ----------
# 开启后调用 /embeddings 做向量检索；关闭则退化为 BM25 关键词检索。
# 注意：豆包向量化用的是方舟的 /embeddings，需单独开通 embedding 模型并把 EMBEDDING_MODEL 换成对应 ID，
#       否则建议保持 false（纯关键词检索在这个知识体量下已经够用，且零额外成本）。
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_SCORE=0.10
# 向量分与关键词分的融合权重（1 = 纯向量，0 = 纯关键词）
RAG_VECTOR_WEIGHT=0.62
