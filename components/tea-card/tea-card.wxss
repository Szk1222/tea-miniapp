.tc {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E9EDE8;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(28, 56, 41, 0.04);
}

.tc--hover {
  background: #FAFBF9;
  transform: scale(0.99);
}

.tc--grid {
  flex-direction: column;
  align-items: stretch;
  padding: 0 0 24rpx;
  overflow: hidden;
}

.tc__thumb {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 auto;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tc--grid .tc__thumb {
  width: 100%;
  height: 220rpx;
  border-radius: 0;
}

.tc__thumb--1 { background: linear-gradient(140deg, #CDE5D6 0%, #9DC9B0 100%); }
.tc__thumb--2 { background: linear-gradient(140deg, #F0E3C7 0%, #D6B983 100%); }
.tc__thumb--3 { background: linear-gradient(140deg, #DCD9EC 0%, #B4AFD8 100%); }
.tc__thumb--4 { background: linear-gradient(140deg, #F2DED4 0%, #DCAE99 100%); }

.tc__nature {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #33513F;
  font-size: 18rpx;
  line-height: 1.6;
}

.tc--grid .tc__nature {
  left: 20rpx;
  bottom: 20rpx;
  font-size: 20rpx;
}

.tc__body {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
  padding-right: 12rpx;
}

.tc--grid .tc__body {
  padding: 22rpx 26rpx 0;
}

.tc__head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tc__name {
  font-size: 31rpx;
  font-weight: 600;
  color: #17251D;
  letter-spacing: 0.4rpx;
}

.tc__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #78877D;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tc__tags {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tc__chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #F4F7F4;
  color: #6E7C73;
  font-size: 20rpx;
  line-height: 1.7;
}

.tc__chip--brand {
  background: #E8F1EC;
  color: #2E6B4F;
  font-weight: 600;
}
